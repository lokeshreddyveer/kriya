{
  "manifest_version": 3,
  "name": "Kriya",
  "version": "0.2.0",
  "description": "Send links, the page you are on, its readable text, and selected text to Kriya on this Mac.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open this page through Kriya" }
}
